# =============================================================
# SubHero Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================================

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Admin
ADMIN_URL=admin/

# Meta Pixel (Facebook)
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_TEST_EVENT_CODE=

# Database (PostgreSQL)
DATABASE_URL=postgres://subhero:subhero@localhost:5432/subhero_db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_URL=redis://localhost:6379/1

# Termii (SMS/OTP)
TERMII_API_KEY=
TERMII_SECRET_KEY=
TERMII_SENDER_ID=SubHero
TERMII_MOCK=True

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SubHero <noreply@subhero.com.ng>

# Outbound APIs
# VTU provider chain. VTU_PROVIDER_ORDER lists the providers in the order they
# are tried; the first one that can deliver serves the order.
VTU_PROVIDER_ORDER=dancity,gsubz
VTU_PROVIDER=dancity

# GSUBZ — fallback provider for data and airtime. The account is not yet
# upgraded for API purchases, so it is kept as a fallback only.
GSUBZ_API_KEY=
GSUBZ_BASE_URL=https://api.gsubz.com
GSUBZ_WEBHOOK_SECRET=
GSUBZ_TIMEOUT=60

# DANCITY / COOL-SUB — primary provider. The merchant API is served from
# https://v2.cool-sub.com/api/v1 and the key is sent as a Bearer token.
DANCITY_API_KEY=
DANCITY_BASE_URL=https://v2.cool-sub.com
DANCITY_WEBHOOK_SECRET=
DANCITY_TIMEOUT=30

# VTU service rollout switches. Services that are off show a "Soon" badge.
VTU_ENABLE_DATA=True
VTU_ENABLE_AIRTIME=True
VTU_ENABLE_CABLE=False
VTU_ENABLE_ELECTRICITY=False
VTU_ENABLE_EXAM=False


JAP_API_KEY=
JAP_API_URL=https://justanotherpanel.com/api/v2

OGAVIRAL_API_KEY=
OGAVIRAL_API_URL=https://ogaviral.com/api/v2

# Squad Payment Gateway (GTBank)
SQUAD_SANDBOX_SECRET_KEY=
SQUAD_SANDBOX_PUBLIC_KEY=
SQUAD_LIVE_SECRET_KEY=
SQUAD_LIVE_PUBLIC_KEY=
SQUAD_ENV=sandbox

# VTU Mock Mode
VTU_MOCK=True

# Brevo Email API (Port 443 HTTPS)
BREVO_API_KEY=
